# =============================================================================
# Docker Compose Environment Configuration
# =============================================================================
# This file contains pre-configured values for local development with Docker.
# These values work with the docker-compose.yml configuration.

# =============================================================================
# Stellar Network Configuration
# =============================================================================

# Stellar Soroban RPC URL (points to the local quickstart container)
NEXT_PUBLIC_STELLAR_RPC_URL=http://localhost:8000/soroban/rpc

# Stellar Horizon URL for historical data
NEXT_PUBLIC_STELLAR_HORIZON_URL=http://localhost:8000

# =============================================================================
# Smart Contract Configuration
# =============================================================================

# Fiat Bridge contract address (populate after deploying to local network)
NEXT_PUBLIC_FIAT_BRIDGE_CONTRACT=

# XLM Stellar Asset Contract address (populate after deploying to local network)
NEXT_PUBLIC_XLM_SAC_CONTRACT=

# =============================================================================
# Payment Provider Configuration
# =============================================================================

# Payout provider (default: paystack)
PAYOUT_PROVIDER=paystack

# Paystack secret key (use test key for local development)
PAYSTACK_SECRET_KEY=sk_test_placeholder

# =============================================================================
# AI Assistant Configuration
# =============================================================================

# Google Gemini API key (optional for local development)
GEMINI_API_KEY=PLACEHOLDER

# =============================================================================
# Development Settings
# =============================================================================

# Node environment
NODE_ENV=development

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
